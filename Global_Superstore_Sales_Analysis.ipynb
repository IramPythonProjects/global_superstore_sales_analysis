# 1. Import Libraries

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from google.colab import files

sns.set_style("whitegrid")

print("Libraries Imported Successfully!")


# 2. Upload Dataset

uploaded = files.upload()

file_name = next(iter(uploaded))

df = pd.read_csv(file_name, encoding="latin1")

print("Dataset Loaded Successfully!")


# 3. Basic Information

print("\nFirst 5 Rows:")
print(df.head())

print("\nDataset Shape:")
print(df.shape)

print("\nColumn Names:")
print(df.columns.tolist())

print("\nMissing Values:")
print(df.isnull().sum())

print("\nStatistical Summary:")
print(df.describe())


# 4. Sales Analysis

total_sales = df["Sales"].sum()
total_profit = df["Profit"].sum()
total_orders = df["Order ID"].nunique()
total_quantity = df["Quantity"].sum()

print("\n========== SALES ANALYSIS ==========")

print("Total Sales:", round(total_sales, 2))
print("Total Profit:", round(total_profit, 2))
print("Total Orders:", total_orders)
print("Total Quantity:", total_quantity)
print("Average Sales:", round(df["Sales"].mean(), 2))


# 5. Category Analysis

category_sales = df.groupby("Category")["Sales"].sum()

print("\nSales by Category:")
print(category_sales)

plt.figure(figsize=(9, 5))

bars = plt.bar(
    category_sales.index,
    category_sales.values,
    color=["skyblue", "lightgreen", "orange"]
)

plt.title("Sales by Category", fontsize=16, fontweight="bold")
plt.xlabel("Category", fontsize=12)
plt.ylabel("Total Sales", fontsize=12)

plt.xticks(rotation=30)
plt.bar_label(bars, fmt="%.0f", padding=3)

plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()


# 6. Region Analysis

region_sales = df.groupby("Region")["Sales"].sum()

print("\nSales by Region:")
print(region_sales)

plt.figure(figsize=(9, 5))

bars = plt.bar(
    region_sales.index,
    region_sales.values,
    color="cornflowerblue"
)

plt.title("Sales by Region", fontsize=16, fontweight="bold")
plt.xlabel("Region", fontsize=12)
plt.ylabel("Total Sales", fontsize=12)

plt.xticks(rotation=30)
plt.bar_label(bars, fmt="%.0f", padding=3)

plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()


# 7. Profit Analysis

category_profit = df.groupby("Category")["Profit"].sum()

print("\nProfit by Category:")
print(category_profit)

plt.figure(figsize=(9, 5))

bars = plt.bar(
    category_profit.index,
    category_profit.values,
    color=["green", "blue", "orange"]
)

plt.title("Profit by Category", fontsize=16, fontweight="bold")
plt.xlabel("Category", fontsize=12)
plt.ylabel("Total Profit", fontsize=12)

plt.xticks(rotation=30)
plt.bar_label(bars, fmt="%.0f", padding=3)

plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()


# 8. Top 10 Products

top_products = (
    df.groupby("Product Name")["Sales"]
    .sum()
    .sort_values(ascending=False)
    .head(10)
    .sort_values()
)

print("\nTop 10 Products:")
print(top_products)

plt.figure(figsize=(11, 7))

bars = plt.barh(
    top_products.index,
    top_products.values,
    color="teal"
)

plt.title("Top 10 Products by Sales",
          fontsize=16, fontweight="bold")

plt.xlabel("Total Sales", fontsize=12)
plt.ylabel("Product Name", fontsize=12)

plt.bar_label(bars, fmt="%.0f", padding=3)

plt.grid(axis="x", alpha=0.3)
plt.tight_layout()
plt.show()


# 9. Business Insights

print("\n========== BUSINESS INSIGHTS ==========")

print("\n1. Best Selling Category:")
print(category_sales.idxmax())

print("\n2. Most Profitable Category:")
print(category_profit.idxmax())

print("\n3. Best Performing Region:")
print(region_sales.idxmax())

print("\n4. Most Sold Product:")

most_sold = df.groupby("Product Name")["Quantity"].sum().idxmax()
print(most_sold)

print("\n5. Highest Sales Product:")

highest_sales = df.groupby("Product Name")["Sales"].sum().idxmax()
print(highest_sales)

print("\n6. Total Loss:")

loss = df.loc[df["Profit"] < 0, "Profit"].sum()
print(round(loss, 2))

print("\n7. Total Dataset Records:")
print(len(df))


# 10. Final Result

print("\n====================================")
print("DATA ANALYSIS COMPLETED SUCCESSFULLY!")
print("====================================")